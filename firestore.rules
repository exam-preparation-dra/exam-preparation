rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isStudentUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.matches('.*@students\\.exam-prep\\.local');
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'diptendu769@gmail.com';
    }

    match /studentAuthState/{studentId} {
      allow read: if true;
      allow write: if isAdmin()
        || (isStudentUser()
        && request.auth.token.email ==
        studentId.lower() + '@students.exam-prep.local');
    }

    match /setupRequests/{studentId} {
      allow read: if true;
      allow create: if
        request.resource.data.studentId == studentId
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /setupCodes/{studentId} {
      allow read, write: if isAdmin();
    }

    match /studentPrivacy/{studentId} {
      allow read: if true;
      allow write: if isAdmin()
        || (isStudentUser()
        && request.auth.token.email ==
        studentId.lower() + '@students.exam-prep.local');
    }

    match /students/{studentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{counterId} {
      allow read: if false;
      allow write: if isAdmin();
    }

    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /chapters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /topics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /exams/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /examSnapshots/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow read, write: if true;
    }

    match /results/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /improvementRequests/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /improvementTests/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /improvementTestSnapshots/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /improvementAttempts/{id} {
      allow read, create, update, delete: if true;
    }

    match /analytics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /battleQuestions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /battleMatches/{code} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /friendRequests/{id} {
      allow read, write: if true;
    }

    match /rivals/{id} {
      allow read, write: if true;
    }

    match /examChallenges/{id} {
      allow read, write: if true;
    }

    match /friendCheers/{id} {
      allow read, write: if true;
    }

    // Friend activity feed (milestones + reactions)
    match /friendActivity/{id} {
      allow read, write: if true;
    }

    match /studentRequests/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /storeInventory/{studentId} {
      allow read, write: if true;
    }

    match /storePurchases/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /storeCardUsage/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /battleRoomCards/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /examCardClaims/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
    // Per-student list of notifications the student deleted (so they stay deleted
    // after re-login / on another device).
    match /studentNotifState/{studentId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // =====================================================================
    // FRIEND CHAT (student/chat.html)
    // Students sign in with Firebase Auth (hidden email stu-0001@students...),
    // so chat rules use the REAL identity: myId() = "STU-0001".
    //  - rooms: only members can read; invitees can see the room they were
    //    invited to (to accept / decline).
    //  - messages: only members read/write; sender must be me; text is a
    //    preset line (<= 100 chars); ONE message per 2 minutes per student
    //    (chatMeta/{me}.lastSentAt, checked here, not just in the browser).
    //  - delete for me  = add my id to deletedFor
    //    delete for all = sender only (deletedForAll = true, text cleared)
    // =====================================================================
    function myId() {
      return request.auth.token.email.split('@')[0].upper();
    }

    match /chatMeta/{sid} {
      allow read: if isStudentUser() && myId() == sid;
      allow create: if isStudentUser() && myId() == sid
        && request.resource.data.keys().hasOnly(['lastSentAt'])
        && request.resource.data.lastSentAt == request.time;
      allow update: if isStudentUser() && myId() == sid
        && request.resource.data.keys().hasOnly(['lastSentAt'])
        && request.resource.data.lastSentAt == request.time
        && request.time >= resource.data.lastSentAt + duration.value(2, 'm');
    }

    match /chatRooms/{roomId} {
      allow get: if isStudentUser()
        && (resource == null
          || myId() in resource.data.members
          || myId() in resource.data.invited);
      allow list: if isStudentUser()
        && (myId() in resource.data.members
          || myId() in resource.data.invited);

      allow create: if isStudentUser()
        && request.resource.data.createdBy == myId()
        && myId() in request.resource.data.members
        && (
          // 1-to-1 chat: both members, deterministic id, nobody invited
          (request.resource.data.type == 'dm'
            && request.resource.data.members.size() == 2
            && request.resource.data.invited.size() == 0
            && roomId in [
                 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1],
                 'dm_' + request.resource.data.members[1] + '_' + request.resource.data.members[0]])
          ||
          // group: only the creator is a member, 1-4 friends invited (max 5 total)
          (request.resource.data.type == 'group'
            && request.resource.data.members == [myId()]
            && request.resource.data.invited.size() >= 1
            && request.resource.data.invited.size() <= 4
            && !(myId() in request.resource.data.invited)
            && request.resource.data.name.size() <= 24)
        );

      allow update: if isStudentUser() && (
        // a member: new last message / unread counters (members & invited untouched)
        (myId() in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMsg', 'lastAt', 'unread']))
        ||
        // a member leaves the group
        (myId() in resource.data.members
          && resource.data.type == 'group'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([myId()].toSet()))
        ||
        // an invitee approves
        (myId() in resource.data.invited
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'invited'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([myId()].toSet())
          && request.resource.data.invited.toSet() == resource.data.invited.toSet().difference([myId()].toSet())
          && request.resource.data.members.size() <= 5)
        ||
        // an invitee declines
        (myId() in resource.data.invited
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invited'])
          && request.resource.data.invited.toSet() == resource.data.invited.toSet().difference([myId()].toSet()))
      );

      // last member out closes the room
      allow delete: if isStudentUser()
        && myId() in resource.data.members
        && resource.data.members.size() == 1;

      match /messages/{msgId} {
        function roomData() {
          return get(/databases/$(database)/documents/chatRooms/$(roomId)).data;
        }
        function cooldownOk() {
          return !exists(/databases/$(database)/documents/chatMeta/$(myId()))
            || request.time >= get(/databases/$(database)/documents/chatMeta/$(myId())).data.lastSentAt
                               + duration.value(2, 'm');
        }

        allow read: if isStudentUser() && myId() in roomData().members;

        allow create: if isStudentUser()
          && myId() in roomData().members
          && request.resource.data.from == myId()
          && request.resource.data.keys().hasOnly(['from', 'key', 'text', 'createdAt', 'deletedFor', 'deletedForAll'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.text.size() <= 100
          && cooldownOk();

        allow update: if isStudentUser()
          && myId() in roomData().members
          && (
            // sender: delete for everyone
            (resource.data.from == myId()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForAll', 'text', 'key'])
              && request.resource.data.deletedForAll == true)
            ||
            // anyone: delete for me
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
              && myId() in request.resource.data.deletedFor
              && request.resource.data.deletedFor.size() <= resource.data.deletedFor.size() + 1)
          );

        // own messages any time; anyone's once older than 6h (keeps only the latest 30)
        allow delete: if isStudentUser()
          && myId() in roomData().members
          && (resource.data.from == myId()
              || resource.data.createdAt < request.time - duration.value(6, 'h'));
      }
    }
  }
}
